# Copy this file to .env and fill in real values. Never commit .env.

# MySQL 8 connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://app:change_me_app@localhost:3306/employee_benefits"

# Scratch database `prisma migrate dev` diffs against. Needs its own
# dedicated database — grant your app DB user privileges on this one too
# (it cannot have global CREATE DATABASE rights).
SHADOW_DATABASE_URL="mysql://app:change_me_app@localhost:3306/employee_benefits_shadow"

# Public origin of this deployment (used for building absolute links such as
# password reset emails). No trailing slash.
ORIGIN="http://localhost:5173"

# Name of the HttpOnly session cookie.
SESSION_COOKIE_NAME="eb_session"

# IANA timezone used to render dates/times in the UI. Data is stored in UTC.
APP_TIMEZONE="Asia/Bangkok"

# ISO 4217 currency code used to format money amounts in the UI.
APP_CURRENCY="THB"

# Optional SMTP settings. When any of these are missing, password-reset links
# are shown/logged locally instead of emailed (clearly labeled as dev mode).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Used only by `prisma/seed.ts` to generate demo account credentials.
# If unset, the seed script generates and prints random passwords once.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_DEVELOPER_EMAIL="developer@example.com"
SEED_USER_EMAIL="user@example.com"

# Optional fixed password for ALL demo accounts (local dev convenience only —
# never set this in a shared/production .env). Per-role overrides below win
# over this. If none of these are set, the seed script falls back to a
# random password printed once per account.
SEED_DEFAULT_PASSWORD="Passw0rd123!"
SEED_ADMIN_PASSWORD=""
SEED_DEVELOPER_PASSWORD=""
SEED_USER_PASSWORD=""

# docker-compose.yml variables for local MySQL.
MYSQL_ROOT_PASSWORD="change_me_root"
MYSQL_USER="app"
MYSQL_PASSWORD="change_me_app"
